# ───────── 로컬 개발 (Docker Postgres) ─────────
# db/docker-compose.yml 의 계정/DB 와 일치
DATABASE_URL=postgres://delivery:delivery@localhost:5432/deliveryapp

# 세션 JWT 서명 키 — 운영에서는 반드시 길고 무작위한 값으로 교체할 것
JWT_SECRET=change-me-to-a-long-random-secret-string

# ───────── 운영(Vercel + Neon) 예시 ─────────
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# JWT_SECRET=<openssl rand -base64 32 등으로 생성한 긴 무작위 문자열>
